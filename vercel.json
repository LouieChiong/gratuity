{
    "version": 2,
    "framework": null,
    "functions": {
        "api/index.php": { "runtime": "vercel-php@0.6.0" }
    },
    "routes": [
        { "src": "/build/(.*)", "dest": "/public/build/" },
        { "src": "/resources/(.*)", "dest": "/public/resources/" },
        { "src": "/favicon/(.*)", "dest": "/public/favicon/" },
        { "src": "/storage/app/(.*)", "dest": "/storage/app/" },
        { "src": "/storage/(.*)", "dest": "/storage/" },
        { "src": "/public/fonts/(.*)", "dest": "/public/fonts/" },
        { "src": "/public/images/(.*)", "dest": "/public/fonts/" },
        { "src": "/(.*)", "dest": "/api/index.php" }
    ],
    "env": {
        "APP_NAME": "Gratuity",
        "APP_ENV": "Production",
        "APP_DEBUG": "true",
        "APP_CONFIG_CACHE": "/tmp/config.php",
        "APP_EVENTS_CACHE": "/tmp/events.php",
        "APP_PACKAGES_CACHE": "/tmp/packages.php",
        "APP_ROUTES_CACHE": "/tmp/routes.php",
        "APP_SERVICES_CACHE": "/tmp/services.php",
        "VIEW_COMPILED_PATH": "/tmp",
        "CACHE_DRIVER": "array",
        "LOG_CHANNEL": "stderr",
        "SESSION_DRIVER": "cookie",
        "LIVEWIRE_MANIFEST_PATH": "/tmp/livewire-components.php"
    }
}