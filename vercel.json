{
    "version": 2,
    "framework": null,
    "functions": {
        "api/index.php": { "runtime": "vercel-php@0.6.0" }
    },
    "routes": [
        { "src": "/build/(.*)", "dest": "/public/build/" },
        { "src": "/resources/css/(.*)", "dest": "/public/resources/css/" },
        { "src": "/resources/js/(.*)", "dest": "/public/resources/js/" },
        { "src": "/public/fonts/(.*)", "dest": "/public/fonts/" },
        { "src": "/public/fonts/Metropolis/(.*)", "dest": "/public/fonts/Metropolis/" },
        { "src": "/public/images/avatar/(.*)", "dest": "/public/images/avatar/" },
        { "src": "/public/images/slide/(.*)", "dest": "/public/images/slide/" },
        { "src": "/public/images/icons/(.*)", "dest": "/public/images/icons/" },
        { "src": "/public/images/causes/(.*)", "dest": "/public/images/causes/" },
        { "src": "/public/images/news/(.*)", "dest": "/public/images/news/" },
        { "src": "/public/images/(.*)", "dest": "/public/images/" },
        { "src": "/(.*)", "dest": "/api/index.php" }
    ],
    "env": {
        "APP_NAME": "Gratuity",
        "APP_ENV": "Production",
        "APP_DEBUG": "true",
        "APP_CONFIG_CACHE": "/tmp/config.php",
        "APP_EVENTS_CACHE": "/tmp/events.php",
        "APP_PACKAGES_CACHE": "/tmp/packages.php",
        "APP_ROUTES_CACHE": "/tmp/routes.php",
        "APP_SERVICES_CACHE": "/tmp/services.php",
        "VIEW_COMPILED_PATH": "/tmp",
        "CACHE_DRIVER": "array",
        "LOG_CHANNEL": "stderr",
        "SESSION_DRIVER": "cookie",
        "LIVEWIRE_MANIFEST_PATH": "/tmp/livewire-components.php"
    }
}